# Browser game portal / standalone game build settings.
#
# Vite embeds every VITE_* variable in the public JavaScript bundle, so never
# put secrets here. Copy this file to `.env.local` (git-ignored) to override
# values on your machine, or set them in your hosting provider's dashboard.
# A malformed optional value is ignored, as if it were empty.

# Site identity: portal or traptheorb. Leave empty for hostname detection in
# the browser (plain localhost is the portal, traptheorb.localhost is the game).
# Builds with no selection generate portal metadata. Use an explicit selection
# for each production domain so HTML, sitemap and the static 404 match it.
VITE_SITE=

# Canonical base URL of the site: used for the canonical link, Open Graph and
# JSON-LD tags in index.html, robots.txt and sitemap.xml.
# Absolute http(s) URL, no trailing slash. Leave empty to use the site default:
# portal -> https://games.mucahid.dev; traptheorb -> https://traptheorb.com
# A malformed URL fails the build so broken canonical links never ship.
VITE_SITE_URL=

# Optional. Contact address shown in the privacy policy.
# Leave empty to show a "contact address coming soon" note instead.
VITE_CONTACT_EMAIL=

# Optional. Google AdSense publisher id: "ca-pub-" followed by 10-20 digits,
# e.g. ca-pub-1234567890123456. Leave empty to disable ads.
# When valid, the build also generates ads.txt.
VITE_ADSENSE_CLIENT=

# Optional. Numeric AdSense ad unit (slot) id for the sidebar ad, 5-20 digits.
VITE_ADSENSE_SLOT_SIDEBAR=

# ------------------------------------------------------------------ API server (apps/api)
# Server-only settings: never prefix them with VITE_, so they never reach the
# browser. The API reads this repository-root file; variables already set in
# the environment win. apps/api/README.md explains each one.

# Postgres connection string. Leave empty in development to use the embedded
# PGlite database (apps/api/.data/pglite). Required when NODE_ENV=production.
# The database must be reachable from wherever the API runs.
DATABASE_URL=

# Signs session cookies: at least 32 random characters (openssl rand -base64 32).
# Required in production. In development an empty value means a throwaway
# secret, so you are signed out whenever the API restarts.
BETTER_AUTH_SECRET=

# Public URL of the site. Auth lives under <url>/api/auth; in development the
# Vite server on :3101 proxies /api to the API. Default: http://localhost:3101
BETTER_AUTH_URL=http://localhost:3101

# Google sign-in: enabled only when both are set. OAuth redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email login codes through Resend: enabled only when both are set, and the
# EMAIL_FROM domain must be verified in Resend. Example:
# EMAIL_FROM=Trap The Orb <noreply@mucahid.dev>
# In development without them, codes are printed to the API log instead.
RESEND_API_KEY=
EMAIL_FROM=

# Port of the API server. Default: 3102
API_PORT=3102

# Optional. Folder of the built site to serve (production), e.g. apps/web/dist.
STATIC_DIR=

# Optional. Extra origins allowed to call the API with cookies (comma-separated),
# for cross-origin setups. The BETTER_AUTH_URL origin is always allowed.
ALLOWED_ORIGINS=

# Optional. Number of reverse proxies in front of the API whose X-Forwarded-For
# entries are trusted for rate limiting (e.g. 1 behind Caddy/Traefik/nginx).
# Default: 0 (use the connection's address).
TRUST_PROXY=

# Optional. "off" skips applying migrations on start. Default: on
DB_MIGRATE=

# Optional. debug | info | warn | error | silent. Default: info
LOG_LEVEL=

# Optional. PGlite data folder when DATABASE_URL is empty, or "memory". Default: apps/api/.data/pglite
PGLITE_DIR=
