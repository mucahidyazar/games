/* Bottom sheets and the content of each: pause, level cleared, modes, Custom setup and settings. */

.sheet-scrim {
    background-color: var(--color-scrim);
}

.sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 92%;
    padding: 10px 20px 20px 20px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-top-width: 1px;
    border-color: var(--color-line);
    background-color: var(--color-surface);
}

.sheet__handle {
    align-self: center;
    flex-shrink: 0;
    width: 40px;
    height: 5px;
    margin-bottom: 14px;
    border-radius: 3px;
    background-color: var(--color-line-strong);
}

.sheet__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.sheet__title {
    font-size: 24px;
    letter-spacing: -0.4px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.sheet__close {
    margin-right: -10px;
}

/* Long content shrinks to the space left and scrolls. */
.sheet__body {
    flex-shrink: 1;
    min-height: 0;
}

.sheet-heading {
    font-size: 26px;
    letter-spacing: -0.5px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.sheet-heading--center {
    -unity-text-align: upper-center;
}

.sheet-subheading {
    margin-top: 6px;
    font-size: 15.5px;
    color: var(--color-muted);
    white-space: normal;
}

.sheet-subheading--center {
    -unity-text-align: upper-center;
}

.sheet-actions {
    margin-top: 22px;
}

.sheet-section {
    margin-top: 18px;
}

.info-sheet,
.custom-sheet {
    flex-shrink: 1;
    min-height: 0;
}

.info-sheet__scroll {
    flex-shrink: 1;
    min-height: 0;
}

.custom-sheet__footer {
    flex-shrink: 0;
    flex-shrink: 0;
    padding-top: 12px;
}

/* ------------------------------------------------------------- modes */

.group-label {
    margin: 18px 4px 8px 4px;
    font-size: 14px;
    -unity-font-definition: var(--font-700);
    color: var(--color-subtle);
}

.group-label--first {
    margin-top: 6px;
}

.mode-row {
    min-height: 66px;
    padding: 0 14px 0 10px;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(0, 0, 0, 0);
}

.mode-row > .tile {
    margin-right: 14px;
}

.mode-row--current {
    background-color: var(--color-teal-tint);
    border-color: var(--color-teal-ring);
}

.mode-row__tick {
    margin-left: 12px;
    -unity-background-image-tint-color: var(--color-accent);
}

/* ----------------------------------------------------- level cleared */

.medal {
    align-self: center;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin: 4px 0 16px 0;
    border-radius: 24px;
    background-color: var(--color-teal);
}

.medal__icon {
    width: 34px;
    height: 34px;
    -unity-background-image-tint-color: var(--color-on-teal);
}

.tally {
    margin-top: 18px;
}

.tally__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 38px;
}

.tally__label {
    font-size: 15.5px;
    -unity-font-definition: var(--font-600);
    color: var(--color-ink-soft);
}

.tally__value {
    font-size: 16px;
    -unity-font-definition: var(--font-700);
    color: var(--color-accent);
}

.tally__value--zero {
    color: var(--color-subtle);
}

.tally__row--total {
    height: 50px;
    margin-top: 6px;
    border-top-width: 1px;
    border-color: var(--color-line);
}

.tally__total-label {
    font-size: 17px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.tally__total-value {
    font-size: 22px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.next-level {
    flex-direction: row;
    align-items: center;
    margin: 10px 0 18px 0;
    padding: 14px 16px;
    border-radius: 18px;
    background-color: var(--color-sunken);
}

.next-level__text-block {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 12px;
}

.next-level__title {
    font-size: 15.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
}

.next-level__text {
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--color-muted);
    white-space: normal;
}

/* ---------------------------------------------------------- settings */

.settings-sheet__theme {
    width: 172px;
}

.settings-sheet__version {
    margin-top: 18px;
    font-size: 13px;
    color: var(--color-subtle);
    -unity-text-align: upper-center;
}

/* ------------------------------------------------------- custom game */

.custom-form {
    padding-bottom: 8px;
}

.preset-bar {
    flex-direction: row;
    flex-shrink: 0;
    height: 52px;
    margin-top: 4px;
    padding: 4px;
    border-radius: 14px;
    background-color: var(--color-sunken);
}

.preset {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
}

.preset__label {
    font-size: 14.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-muted);
}

.preset--current {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-line);
}

.preset--current .preset__label {
    color: var(--color-ink);
}

.setting {
    margin-top: 10px;
}

.setting__head {
    flex-direction: row;
    align-items: center;
    height: 44px;
}

.setting__label {
    flex-grow: 1;
    font-size: 15.5px;
    -unity-font-definition: var(--font-600);
    color: var(--color-ink);
}

.setting__value-row {
    flex-direction: row;
    align-items: center;
}

.setting__value-row > .orb-lineup {
    margin-left: 8px;
}

.setting__value {
    font-size: 15.5px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.limit-toggle {
    width: 48px;
    height: 44px;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-line);
    background-color: var(--color-sunken);
}

.limit-toggle__label {
    font-size: 17px;
    -unity-font-definition: var(--font-700);
    color: var(--color-muted);
}

.limit-toggle--on {
    background-color: var(--color-teal);
    border-color: var(--color-teal);
}

.limit-toggle--on .limit-toggle__label {
    color: var(--color-on-teal);
}

.custom-form__hint {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--color-subtle);
    white-space: normal;
}
