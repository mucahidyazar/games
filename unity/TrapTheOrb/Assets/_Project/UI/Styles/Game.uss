/* The three screens (home, play and the end of a run) and the field they share. */

/* ------------------------------------------------------------- field */

.board-card {
    flex-shrink: 0;
    border-width: 1.5px;
    border-radius: 18px;
    border-color: var(--color-line);
    overflow: hidden;
}

/* Behind the home screen the field runs edge to edge, without its frame. */
.board-card--backdrop {
    border-width: 0;
    border-radius: 0;
}

.board {
    flex-grow: 1;
}

.board__canvas,
.points-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.points-popup {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    overflow: visible;
}

.points-popup__text {
    position: absolute;
    translate: -50% -50%;
    font-size: 18px;
    -unity-font-definition: var(--font-800);
    -unity-text-outline-width: 2px;
    white-space: nowrap;
}

.theme-navy .points-popup__text {
    -unity-text-outline-color: rgba(11, 22, 48, 0.9);
}

.theme-light .points-popup__text {
    -unity-text-outline-color: rgba(255, 255, 255, 0.92);
}

/* -------------------------------------------------------------- home */

.home__board-slot {
    align-items: center;
    justify-content: center;
}

.home__fade {
    -unity-background-scale-mode: stretch-to-fill;
}

.home__top {
    position: absolute;
    flex-direction: row;
}

.home__top > .icon-button {
    margin-left: 10px;
}

.home__hero {
    position: absolute;
    top: 20%;
    left: 24px;
    right: 24px;
    align-items: center;
}

.home__logo {
    width: 76px;
    height: 76px;
}

.wordmark {
    flex-direction: row;
    margin-top: 20px;
}

.wordmark__text {
    font-size: 44px;
    letter-spacing: -1.3px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
    white-space: nowrap;
}

.wordmark__text--accent {
    margin-left: 11px;
    color: var(--color-accent);
}

.home__pitch {
    margin-top: 12px;
    max-width: 290px;
    font-size: 17px;
    color: var(--color-ink-soft);
    -unity-text-align: upper-center;
    white-space: normal;
}

.home__dock {
    position: absolute;
}

.mode-card {
    flex-direction: row;
    align-items: center;
    min-height: 76px;
    padding: 12px 16px 12px 14px;
    border-radius: 20px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-line);
}

.mode-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 14px;
    overflow: hidden;
}

.mode-card__name {
    font-size: 17px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
}

.mode-card__detail {
    margin-top: 2px;
    font-size: 14px;
    color: var(--color-muted);
    white-space: normal;
}

.mode-card__change {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 10px;
}

.mode-card__change-label {
    font-size: 15px;
    -unity-font-definition: var(--font-700);
    color: var(--color-accent);
}

.mode-card__chevron {
    margin-left: 2px;
    -unity-background-image-tint-color: var(--color-accent);
}

/* -------------------------------------------------------------- play */

.play__inner {
    flex-grow: 1;
}

/* The HUD: one row everywhere, plus a slim second row in modes with a countdown or a wall budget. */
.hud {
    flex-shrink: 0;
}

.hud__main {
    flex-direction: row;
    align-items: center;
    height: 48px;
}

.hud__pause {
    flex-shrink: 0;
}

.hud__area {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 12px;
}

.area-ring {
    width: 40px;
    height: 40px;
    --ring-track: var(--color-sunken);
    --ring-progress: var(--color-teal);
    --ring-reached: var(--color-accent);
}

.hud__area-text {
    margin-left: 10px;
}

.hud__percent {
    font-size: 19px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
    white-space: nowrap;
}

.hud__target {
    margin-top: 1px;
    font-size: 12.5px;
    -unity-font-definition: var(--font-600);
    color: var(--color-subtle);
    white-space: nowrap;
}

.hud__spacer {
    flex-grow: 1;
    flex-shrink: 1;
}

.hud__lives {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 10px;
}

.hud__hearts {
    flex-direction: row;
}

.hud__heart {
    width: 19px;
    height: 19px;
    margin-left: 2px;
    -unity-background-image-tint-color: var(--color-heart);
}

.hud__heart--lost {
    -unity-background-image-tint-color: var(--color-heart-lost);
}

.hud__lives-count {
    margin-left: 3px;
    font-size: 15px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
    white-space: nowrap;
}

.hud__score-block {
    align-items: flex-end;
    flex-shrink: 0;
    min-width: 72px;
    margin-left: 14px;
}

.hud__level {
    font-size: 12.5px;
    -unity-font-definition: var(--font-600);
    color: var(--color-subtle);
    white-space: nowrap;
}

.hud__score {
    margin-top: 1px;
    font-size: 22px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
    white-space: nowrap;
}

/* Lined up with the progress ring, under the pause button's column. */
.hud__status {
    flex-direction: row;
    margin: 6px 0 0 56px;
}

.hud__chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
    margin-right: 8px;
    padding: 0 11px;
    border-radius: 15px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-line);
}

.hud__chip-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    -unity-background-image-tint-color: var(--color-muted);
}

.hud__chip-text {
    font-size: 14px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
    white-space: nowrap;
}

.hud__chip--warn {
    border-color: var(--color-coral-500);
}

.hud__chip--warn .hud__chip-text {
    color: var(--color-danger);
}

.hud__chip--warn .hud__chip-icon {
    -unity-background-image-tint-color: var(--color-danger);
}

.play__board-slot {
    flex-grow: 1;
    margin: 10px 0;
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------- run over */

.run-over__veil {
    background-color: var(--color-page);
}

.run-over__content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.run-over__summary {
    align-items: center;
    margin-top: 6%;
}

.run-over__reason {
    font-size: 16px;
    -unity-font-definition: var(--font-700);
    color: var(--color-muted);
    -unity-text-align: upper-center;
    white-space: normal;
}

.run-over__score {
    margin: 10px 0 8px 0;
    font-size: 80px;
    letter-spacing: -3px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
    white-space: nowrap;
}

.run-over__stats {
    margin-top: 12px;
    font-size: 16px;
    -unity-font-definition: var(--font-600);
    color: var(--color-ink-soft);
}

.run-over__save {
    margin-top: 32px;
}

.run-over__save-title {
    margin: 0 4px 10px 4px;
    font-size: 15px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
}

.run-over__save-row {
    flex-direction: row;
}

.run-over__save-button {
    width: 96px;
    height: 54px;
    margin-left: 10px;
}

.run-over__note {
    margin: 10px 4px 0 4px;
    font-size: 13.5px;
    color: var(--color-subtle);
    white-space: normal;
}

.run-over__note--center {
    margin-top: 20px;
    -unity-text-align: upper-center;
}

.run-over__spacer {
    flex-grow: 1;
}
