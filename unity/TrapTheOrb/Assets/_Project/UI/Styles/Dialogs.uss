/* Long content inside sheets: "How to play" and the device high scores. */

/* ------------------------------------------------------------- prose */

.prose {
    padding-bottom: 12px;
}

.prose__heading {
    margin: 24px 0 8px 0;
    font-size: 19px;
    letter-spacing: -0.2px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.prose__heading--first {
    margin-top: 4px;
}

.prose__paragraph {
    margin-bottom: 10px;
    font-size: 15.5px;
    color: var(--color-ink-soft);
    white-space: normal;
}

.prose__bullet {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.prose__marker {
    width: 6px;
    height: 6px;
    margin: 9px 12px 0 4px;
    border-radius: 3px;
    background-color: var(--color-teal);
    flex-shrink: 0;
}

.prose__bullet--orb {
    align-items: center;
}

.prose__bullet--orb .orb-lineup {
    margin: 0 10px 0 0;
}

.prose__bullet-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 15.5px;
    color: var(--color-ink-soft);
    white-space: normal;
}

.prose__term {
    margin-bottom: 12px;
}

.prose__term-name {
    font-size: 15.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
}

.prose__term-text {
    margin-top: 2px;
    font-size: 15px;
    color: var(--color-muted);
    white-space: normal;
}

.prose__row {
    flex-direction: row;
    padding: 9px 0;
    border-bottom-width: 1px;
    border-color: var(--color-line);
}

.prose__row--head {
    padding-top: 0;
}

.prose__row-label {
    width: 42%;
    padding-right: 12px;
    font-size: 14.5px;
    -unity-font-definition: var(--font-600);
    color: var(--color-ink);
    white-space: normal;
}

.prose__row-value {
    flex-grow: 1;
    flex-shrink: 1;
    width: 58%;
    font-size: 14.5px;
    color: var(--color-muted);
    white-space: normal;
}

.prose__row--head .prose__row-label,
.prose__row--head .prose__row-value {
    font-size: 13px;
    -unity-font-definition: var(--font-700);
    color: var(--color-subtle);
}

/* ------------------------------------------------------- high scores */

.scores__tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px -4px 8px -4px;
}

.scores__tab {
    height: 44px;
    margin: 4px;
    padding: 0 14px;
    justify-content: center;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--color-line);
    background-color: var(--color-sunken);
}

.scores__tab-label {
    font-size: 14.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-muted);
}

.scores__tab--current {
    background-color: var(--color-teal);
    border-color: var(--color-teal);
}

.scores__tab--current .scores__tab-label {
    color: var(--color-on-teal);
}

.scores__table {
    margin-top: 8px;
}

.scores__empty {
    padding: 32px 12px;
    font-size: 15.5px;
    color: var(--color-muted);
    -unity-text-align: upper-center;
    white-space: normal;
}

.scores__row {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    border-bottom-width: 1px;
    border-color: var(--color-line);
}

.scores__row--head {
    min-height: 32px;
}

.scores__rank-head,
.scores__name-head,
.scores__score-head,
.scores__level-head {
    font-size: 12.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-subtle);
}

.scores__rank-head,
.scores__rank {
    width: 44px;
}

.scores__name-head,
.scores__name {
    flex-grow: 1;
    flex-shrink: 1;
}

.scores__score-head,
.scores__score {
    width: 84px;
    -unity-text-align: middle-right;
}

.scores__level-head,
.scores__level {
    width: 52px;
    -unity-text-align: middle-right;
}

.rank {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: var(--color-sunken);
    color: var(--color-ink-soft);
    font-size: 14px;
    -unity-font-definition: var(--font-800);
    -unity-text-align: middle-center;
}

.rank--podium-1 { background-color: var(--color-gold); color: #0f2548; }
.rank--podium-2 { background-color: var(--color-silver); color: #0f2548; }
.rank--podium-3 { background-color: var(--color-bronze); color: #0f2548; }

.scores__name-text {
    font-size: 15.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-ink);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.scores__when {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--color-subtle);
}

.scores__score {
    font-size: 16px;
    -unity-font-definition: var(--font-800);
    color: var(--color-ink);
}

.scores__level {
    font-size: 15px;
    -unity-font-definition: var(--font-600);
    color: var(--color-muted);
}

.scores__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
}

.scores__footnote {
    flex-shrink: 1;
    font-size: 13px;
    color: var(--color-subtle);
    white-space: normal;
}

.scores__clear {
    flex-shrink: 0;
    height: 44px;
    margin-left: 12px;
    padding: 0 14px;
    justify-content: center;
    border-radius: 14px;
}

.scores__clear-label {
    font-size: 14.5px;
    -unity-font-definition: var(--font-700);
    color: var(--color-danger);
}

.scores__clear--confirm {
    background-color: var(--color-sunken);
}
