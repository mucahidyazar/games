{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared API for Mucahid's browser games: auth, profiles, replay-verified runs and leaderboards.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@games/contract": "workspace:*",
    "@games/trap-the-orb-engine": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
